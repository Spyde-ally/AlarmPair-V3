<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏰ AlarmPair"
            android:textColor="@color/textPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Status bar -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/colorAccent"
            android:textSize="72sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- PAIRING PANEL -->
        <LinearLayout
            android:id="@+id/panelPairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PAIR DEVICES"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCreatePair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create Private Pair"
                style="@style/PrimaryButton"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnJoinPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join with Invite Code"
                style="@style/PrimaryButton" />

        </LinearLayout>

        <!-- ALARM PANEL -->
        <LinearLayout
            android:id="@+id/panelAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SET SHARED ALARM"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="12dp" />

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:timePickerMode="spinner"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSetAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SET ALARM FOR BOTH"
                style="@style/PrimaryButton" />

        </LinearLayout>

        <!-- ALARM ACTIVE PANEL -->
        <LinearLayout
            android:id="@+id/panelAlarmActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAlarmActiveInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 ALARM RINGING"
                android:textColor="@color/warn"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STOP / I'M UP"
                style="@style/DangerButton"
                android:enabled="false" />

        </LinearLayout>

        <!-- GOALS PANEL -->
        <LinearLayout
            android:id="@+id/panelGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR GOALS FOR TODAY"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvGoalsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Both of you are awake! Write your goals for today."
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etGoals"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="What will you accomplish today?"
                android:background="@color/background"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:padding="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSubmitGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUBMIT GOALS"
                style="@style/PrimaryButton" />

            <!-- Partner goals display -->
            <TextView
                android:id="@+id/tvPartnerGoalsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PARTNER'S GOALS"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPartnerGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:background="@color/background"
                android:padding="12dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- WAKE CHECK PANEL -->
        <LinearLayout
            android:id="@+id/panelWakeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ARE YOU STILL HERE?"
                android:textColor="@color/warn"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvWakeCheckTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm in 30s or we'll ask again"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnImHere"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I'M HERE ✓"
                style="@style/WarnButton" />

        </LinearLayout>

        <!-- WAKE OTHER PANEL -->
        <LinearLayout
            android:id="@+id/panelWakeOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnWakeOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 WAKE THE OTHER PERSON"
                style="@style/WarnButton" />

            <TextView
                android:id="@+id/tvManualWakeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
