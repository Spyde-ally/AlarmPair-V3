<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#6750A4</item>
        <item name="colorPrimaryDark">#4F378B</item>
        <item name="colorAccent">#E8DEF8</item>
        <item name="android:windowBackground">#0F0F1A</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0C8</item>
    </style>

    <style name="BigCountdown" parent="TextAppearance.AppCompat.Display1">
        <item name="android:textColor">#E8DEF8</item>
        <item name="android:textSize">64sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatusText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">#B0B0C8</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#6750A4</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#B00020</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WarnButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#000000</item>
        <item name="android:backgroundTint">#F4B400</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
